<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <!-- CounterStrikeSharp v1.0.376 hosts plugins on the .NET 10 runtime it bundles. -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <!-- CounterStrikeSharp loads plugins/<Name>/<Name>.dll, so the file name must match the folder. -->
    <AssemblyName>CounterStrikeProgression</AssemblyName>
    <!-- Released as a zip of the plugin folder, never as a NuGet package. -->
    <IsPackable>false</IsPackable>
    <!-- Every package DLL has to sit next to the plugin, because the host resolves nothing else. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CounterStrikeProgression.Core\CounterStrikeProgression.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host supplies CounterStrikeSharp.API. A second copy in the plugin folder would load in the
         plugin's own context and break type identity with the host's, so only the compile asset is used. -->
    <PackageReference Include="CounterStrikeSharp.API" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="ktsu.Semantics.Strings" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
</Project>
